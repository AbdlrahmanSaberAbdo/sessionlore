{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["packages/*/src", "packages/*/test", "vitest.config.ts"]
}
